# Copia este archivo a .env y ajusta los valores.
# No commitear .env.

SECRET_KEY=cambia-esta-clave-por-una-aleatoria

# PostgreSQL propio (lectura/escritura)
POSTGRES_USER=rcs
POSTGRES_PASSWORD=rcs_dev_password
POSTGRES_DB=rcs
DATABASE_URL=postgresql+psycopg://rcs:rcs_dev_password@db:5432/rcs

# Usuario inicial (se crea con `flask init-db`)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin_dev_password

# Subidas y workspace
MAX_UPLOAD_MB=200
WORKSPACE_ROOT=/workspace

# Rutas del host montadas en los contenedores
# El core y sus datos viven dentro del proyecto: ./core y ./core_data.
DATOS_PATH_HOST=/home/hriquelmez/datos
DATOS_PATH=/data

# Rutas dentro del contenedor
CSN_DUMP_PATH=/data/csn/dumps/csn_test_full_2026-09-30.dump

# Listas de estaciones de Seisan (STATION*.HYP). El manifiesto declara el
# nombre de la variable; aquí va la ruta real.
RCS_SEISAN_STATIONS_DIR=/data/csn/datseisan

# Enriquecer residuales desde fuentes locales en el trabajo (1 = sí).
RCS_ENRIQUECER_RESIDUALES=1

# Veto por tendencia histórica en la clasificación de sospechosos.
# 1 = aplica el veto; 0 = vuelve a la regla anterior.
RCS_VETO_TENDENCIA=1

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Datos de cartopy (Natural Earth) montados en solo lectura
CARTOPY_DATA_DIR_HOST=/home/hriquelmez/datos/cartopy
CARTOPY_DATA_DIR=/data/cartopy

# Servidor de catálogos por SSH (valores por defecto del core)
CATALOGOS_SSH_HOST=10.54.217.9
CATALOGOS_SSH_USER=sysopr

# SeisComp: solo lectura. Usar un rol con SELECT y CONNECT en todas las bases
# (por ejemplo rcs_ro) y default_transaction_read_only=on.
SEISCOMP_DB_HOST=10.54.217.69
SEISCOMP_DB_PORT=5432
SEISCOMP_DB_NAME=seiscomp2
SEISCOMP_DB_USER=
SEISCOMP_DB_PASSWORD=
SEISCOMP_RADIO_KM=400

# Base central CSN: solo lectura. La conexión se guarda fuera del repositorio,
# en ${DATOS_PATH_HOST}/csn/credenciales.env, y se carga como env_file opcional
# para web y worker. El usuario debe tener SELECT y
# default_transaction_read_only=on.
# Ejemplo del contenido de credenciales.env:
# RCS_CENTRAL_DSN=postgresql://usuario_ro:clave@host:5432/base

# Servicio auxiliar de disponibilidad de formas de onda.
# El contenedor `disponibilidad` monta el SeisComp y el SDS del host.
SEISCOMP_HOST_ROOT=/home/hriquelmez/seiscomp
SDS_HOST_ROOT=/mnt/sds
RCS_DISPONIBILIDAD_URL=http://disponibilidad:8010
RCS_DISPONIBILIDAD_TOKEN=cambia-este-token
RCS_DISPONIBILIDAD_TIMEOUT=240
RCS_DISPONIBILIDAD_MAX_ESTACIONES=150
RCS_DISPONIBILIDAD_MAX_STREAMS=5000
# Si queda vacío, se lee el recordstream desde global.cfg.
RCS_RECORDSTREAM=

# Mapas: auto | online | offline
MAPS_MODE=auto

# Matplotlib sin interfaz gráfica
MPLBACKEND=Agg

# Producción: poner en 1 (requiere HTTPS)
SESSION_COOKIE_SECURE=0

# Fuente local principal por defecto (seiscomp | seisan)
DEFAULT_PRIMARY_LOCAL=seiscomp

APP_VERSION=0.7.3
